{
  "name": "claude-launcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Claude 一键启动器 — 配置生成 + 链路体检 + Claude 起停（Windows / Tauri）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "node scripts/gen-icon.mjs && tauri icon src-tauri/app-icon.png",
    "build:wasm": "wasm-pack build ferry-wasm --target web --release --out-dir ../web/src/ferry-wasm --out-name ferry_wasm",
    "dev:web": "vite --config vite.config.web.ts",
    "build:web": "npm run build:wasm && tsc --noEmit && vite build --config vite.config.web.ts"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
