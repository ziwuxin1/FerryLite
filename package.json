{
  "name": "claude-launcher",
  "private": true,
  "version": "1.4.3",
  "type": "module",
  "description": "FerryLite — desktop and router Clash YAML generator and editor",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "node scripts/gen-icon.mjs && tauri icon src-tauri/app-icon.png",
    "build:wasm": "wasm-pack build ferry-wasm --target web --release --out-dir ../web/src/ferry-wasm --out-name ferry_wasm",
    "dev:web": "vite --config vite.config.web.ts",
    "build:web": "npm run build:wasm && tsc --noEmit && vite build --config vite.config.web.ts",
    "test:editor": "node --experimental-strip-types --test scripts/test-yaml-editor.mjs scripts/test-routing-draft.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "codemirror": "^6.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
